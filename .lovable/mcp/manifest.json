{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://gnbvqadouvnrhjlqtyql.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "rent-ghana-now",
      "version": "0.1.0",
      "title": "Rent Ghana Now"
    },
    "tools": [
      {
        "name": "search_rentals",
        "title": "Search rentals",
        "description": "Search approved rental listings in Ghana by keyword and city.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "query": {
              "description": "Words in the rental item title.",
              "type": "string",
              "maxLength": 100
            },
            "city": {
              "description": "Ghanaian city, such as Accra or Kumasi.",
              "type": "string",
              "maxLength": 80
            },
            "limit": {
              "default": 10,
              "description": "Maximum listings to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 25
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "check_rental_availability",
        "title": "Check rental availability",
        "description": "Check which dates are fully booked for a rental listing.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "listingId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The rental listing ID returned by search_rentals."
            }
          },
          "required": [
            "listingId"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_my_bookings",
        "title": "List my bookings",
        "description": "List rental requests and bookings belonging to the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Maximum bookings to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "cancel_pending_booking",
        "title": "Cancel pending booking",
        "description": "Cancel one pending rental request belonging to the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "bookingId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The booking ID returned by list_my_bookings."
            }
          },
          "required": [
            "bookingId"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
